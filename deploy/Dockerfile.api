FROM python:3.12-slim-bookworm AS dependencies
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY deploy/requirements-runtime.txt ./requirements-runtime.txt
RUN python -m pip install --no-cache-dir --prefix=/install -r requirements-runtime.txt

FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/srv/backend DATA_DIR=/srv/data
RUN groupadd --gid 10001 shushi && useradd --uid 10001 --gid 10001 --no-create-home shushi \
    && mkdir -p /srv/data && chown 10001:10001 /srv/data && chmod 0700 /srv/data
COPY --from=dependencies /install /usr/local
WORKDIR /srv
COPY backend/app ./backend/app
COPY backend/alembic ./backend/alembic
COPY backend/alembic.ini ./backend/alembic.ini
COPY deploy/start_api.py deploy/preflight.py deploy/check_api.py ./deploy/
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --start-period=90s --retries=3 \
    CMD ["python", "/srv/deploy/check_api.py"]
ENTRYPOINT ["python", "/srv/deploy/start_api.py"]
