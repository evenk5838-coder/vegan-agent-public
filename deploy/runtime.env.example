# TEMPLATE ONLY. Copy outside the checkout, chmod 600, and fill privately after approval.
# Single-quote secrets containing $, # or spaces. Do not use shell expansions.
SITE_DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=
# Only for an explicitly authorized independent restore profile; never reuses source credentials.
RESTORE_POSTGRES_PASSWORD=
RELEASE_TAG=2026-10-26-candidate-1

# Safe default. Enable only after the real-call acceptance budget is approved.
EXTERNAL_CALLS_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AMAP_API_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
TRANSCRIPTION_PROVIDER=aihubmix
TRANSCRIPTION_API_KEY=
# AI HubMix speech-to-text. Key stays runtime-only; never reuse another provider's key.
TRANSCRIPTION_ENDPOINT=https://aihubmix.com/v1/audio/transcriptions
TRANSCRIPTION_MODEL=whisper-large-v3
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Conservative initial quotas; these do not authorize vendor charges or quota increases.
DAILY_EXTERNAL_LIMIT=10
WEEKLY_EXTERNAL_LIMIT=30
GLOBAL_DAILY_EXTERNAL_LIMIT=30
GLOBAL_WEEKLY_EXTERNAL_LIMIT=100
