      "title": "醪糟小汤圆",
      "source": "https://github.com/Anduin2017/HowToCook/blob/5fb3140c20b2a713296696dc6fdd3b83ccc617a6/dishes/staple/%E9%86%AA%E7%B3%9F%E5%B0%8F%E6%B1%A4%E5%9C%86.md",
      "ingredients": [
        "水 300ml",
        "小汤圆 250g",
        "醪糟 50g",
        "枸杞 5 颗（可选）",
        "白糖（按口味，原文未给用量）"
      ],
      "steps": [
