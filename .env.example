# 复制为项目根目录 .env，只在本机填写，不在聊天中发送真实值。
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
# 留空时使用项目 data/postgres 的本地开发实例；生产必须配置独立数据库。
DATABASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AMAP_API_KEY=
# 默认不开启外部调用。先确认账号计费和资料保留政策，再由用户改为 true。
EXTERNAL_CALLS_ENABLED=false
DAILY_EXTERNAL_LIMIT=10
WEEKLY_EXTERNAL_LIMIT=30
GLOBAL_DAILY_EXTERNAL_LIMIT=30
GLOBAL_WEEKLY_EXTERNAL_LIMIT=100
# 已选AI HubMix中文短音频转写；仅私下填写该平台Key，不代表获得新增费用授权。
# 旧百炼配置仍可显式选择bailian，需配套其北京端点、模型与Key；不会自动切换平台。
TRANSCRIPTION_PROVIDER=aihubmix
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_ENDPOINT=https://aihubmix.com/v1/audio/transcriptions
TRANSCRIPTION_MODEL=whisper-large-v3
# 页内地图：公开 JS 标识 + 安全密钥 + 同源受限代理地址（服务端持有，不下发网页）
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
AMAP_SERVICE_HOST=
# 仅在真实加载/定位验收通过后才可置 true，不能用配置存在代替验证
AMAP_JS_VERIFIED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
